# Server Configuration
PORT=3000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Connections
DATABASE_URL=postgresql://username:password@localhost:5432/civicresolve?sslmode=disable
MONGODB_URI=mongodb://localhost:27017/civicresolve

# NVIDIA NIM / AI Inference Configuration
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_MODEL=meta/llama-3.2-11b-vision-instruct
NVIDIA_EMBEDDING_MODEL=nvidia/llama-nemotron-embed-vl-1b-v2

# AI Agent & Gate Configuration
AGENT_MIN_CLUSTER_SIZE=3
AGENT_PS_SIMILARITY_THRESHOLD=0.82
AGENT_CLUSTER_SIMILARITY_THRESHOLD=0.65
AGENT_DEDUP_SIMILARITY_THRESHOLD=0.88
AGENT_URGENT_CHANNEL=urgent_escalation_events

# AI Agent Queue & Concurrency Configuration
AGENT_QUEUE_CONCURRENCY=1
AGENT_QUEUE_POLL_INTERVAL_MS=5000
AGENT_QUEUE_MAX_RETRIES=3
AGENT_QUEUE_RETRY_DELAY_MS=2000

# Authentication & JWT Secrets
JWT_ACCESS_SECRET=your_jwt_access_secret_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_32_chars
JWT_REFRESH_EXPIRES_IN=7d

# Media Storage (Cloudinary)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
